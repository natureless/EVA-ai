# EVA v0.1 Environment Configuration
# Copy this file to .env and fill in values as needed.

# Core
EVA_APP_NAME=EVA
EVA_ENV=dev
EVA_HOST=0.0.0.0
EVA_PORT=8000
EVA_LOG_LEVEL=INFO

# Paths (relative to project root)
EVA_BASE_DIR=.
EVA_DATA_DIR=data
EVA_LOG_DIR=logs
EVA_LOG_FILE=eva.log
EVA_DB_PATH=data/eva.db
EVA_UI_DIR=ui/web
EVA_TEMPLATE_DIR=ui/web/templates
EVA_STATIC_DIR=ui/web/static
EVA_SNAPSHOT_DIR=data/snapshots
EVA_LATEST_SNAPSHOT_PATH=data/snapshots/latest.json
EVA_PROFILE_PATH=data/profile.json
EVA_SELF_MODEL_PATH=data/self_model.json

# Timing (seconds)
EVA_TICK_INTERVAL_SEC=0.5
EVA_QUEUE_POLL_TIMEOUT_SEC=0.5
EVA_MAX_RECENT_ITEMS=20
EVA_REQUEST_TIMEOUT_SEC=8.0
EVA_RESULT_TTL_SEC=60.0
# Maximum request lifetime before a retained expiry/unknown-outcome receipt.
EVA_RESULT_PENDING_TIMEOUT_SEC=300.0
# Pending requests plus retained terminal receipts. Full capacity rejects ingress.
EVA_RESULT_REGISTRY_CAPACITY=20000
EVA_SCHEDULER_TICK_INTERVAL_SEC=10
EVA_SCHEDULER_MAINTENANCE_INTERVAL_SEC=60
EVA_SCHEDULER_SNAPSHOT_INTERVAL_SEC=120
EVA_STAGNATION_THRESHOLD_SEC=86400
EVA_REMINDER_COOLDOWN_SEC=43200

# Concurrency and agent execution backend
EVA_COGNITION_WORKER_COUNT=1
EVA_AGENT_WORKER_BACKEND=thread
EVA_AGENT_WORKER_COUNT=4
EVA_AGENT_EXECUTION_TIMEOUT_SEC=120
# Process mode: chat/docs text only, no tools or file agents; no OS sandbox.
# Keep one Uvicorn process. These queue/recycling settings apply to process mode.
EVA_AGENT_WORKER_QUEUE_CAPACITY=16
EVA_AGENT_WORKER_QUEUE_TIMEOUT_SEC=5
EVA_AGENT_WORKER_MAX_TASKS=100

# Experimental scheduler (off by default; mutually exclusive with MVSC).
EVA_ENABLE_MINIMAL_BRAIN=false
EVA_MINIMAL_BRAIN_QUEUE_CAPACITY=64
EVA_MINIMAL_BRAIN_POLL_SEC=0.02
EVA_ENABLE_MVSC_PIPELINE=false
# MVSC attaches experiment adapters only; HTTP continues on the legacy consumer.

# Security
# Required when EVA_ENV=production. Send as the X-API-Token header.
EVA_API_TOKEN=
# Optional Cloudflare Access login. Configure all four together; keep blank locally.
EVA_CF_ACCESS_TEAM_DOMAIN=
EVA_CF_ACCESS_AUD=
EVA_CF_ACCESS_ALLOWED_EMAILS=
EVA_PUBLIC_ORIGIN=
# Enable only behind a trusted reverse proxy that replaces X-Forwarded-For.
EVA_TRUST_PROXY_HEADERS=false

# High-risk agent tools are opt-in.
EVA_ENABLE_CODE_TOOL=false
EVA_ENABLE_NETWORK_TOOLS=false
EVA_ENABLE_US_MARKET_SNAPSHOT=false

# Persist business goals in EVA_DB_PATH; request success remains pending verification.
# Requires SQLite. Does not enable action replay or automatically create goals.
EVA_ENABLE_BUSINESS_GOALS=false

# Durable drafts, sealed Episodes and terminal-notification outbox in EVA_DB_PATH (SQLite).
# Recovery records unknown outcomes; never replays actions. Independent of goals.
EVA_ENABLE_PROCESSING_EPISODES=false
# Durable HTTP admission/claims/receipts. Single runtime, SQLite only; no restart replay.
EVA_ENABLE_DURABLE_REQUESTS=false
# Resume only proven unclaimed requests after restart; original deadlines/policy apply.
EVA_RESUME_DURABLE_REQUESTS=false
# Commit actual world/memory input references before an agent invocation.
# Requires durable requests; installs SQLite S2/S3 revision tracking.
EVA_ENABLE_ACTION_CONTEXT=false

# ── LLM Configuration ───────────────────────────────────────
# EVA auto-detects provider from API keys (priority order):
#   ANTHROPIC_API_KEY → Claude
#   DEEPSEEK_API_KEY  → DeepSeek (deepseek-chat)
#   OPENAI_API_KEY   → OpenAI
#   None              → mock (echo mode, safe for testing)
#
# Explicit override:
# EVA_LLM_PROVIDER=deepseek      # claude | openai | deepseek
# EVA_LLM_MODEL=deepseek-chat

# ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
# OPENAI_API_KEY=

# ── LLM Tuning (applies to both providers) ─────────────────
# EVA_LLM_TEMPERATURE=0.7        # 0.0-2.0, lower = more deterministic
# EVA_LLM_MAX_TOKENS=1024        # max response length
# EVA_LLM_TOP_P=0.9             # nucleus sampling
# EVA_LLM_TIMEOUT=30            # request timeout seconds

# ── Conversation response modes ───────────────────────────
# normal uses the provider's regular response policy; deep enables native
# reasoning when the configured model is known to support it. Unknown/custom
# models use the explicit prompt policy and never claim native reasoning.
# EVA_LLM_REASONING_STYLE=auto  # auto | prompt | openai | deepseek | claude-adaptive | claude-budget
# EVA_DEEP_MAX_TOKENS=4096       # upper bound for a deep response
# EVA_DEEP_TIMEOUT=90            # deep request timeout seconds (1-600)

# ── Storage Backend ─────────────────────────────────────────
# EVA_STORAGE_BACKEND=sqlite     # sqlite (default) | postgresql
# PostgreSQL (when backend=postgresql):
# EVA_PG_HOST=localhost
# EVA_PG_PORT=5432
# EVA_PG_DATABASE=eva
# EVA_PG_USER=eva
# EVA_PG_PASSWORD=
