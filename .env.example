# EVA v0.1 Environment Configuration
# Copy this file to .env and fill in values as needed.

# Core
EVA_APP_NAME=EVA
EVA_ENV=dev
EVA_HOST=0.0.0.0
EVA_PORT=8000
EVA_LOG_LEVEL=INFO

# Paths (relative to project root)
EVA_BASE_DIR=.
EVA_DATA_DIR=data
EVA_LOG_DIR=logs
EVA_LOG_FILE=eva.log
EVA_DB_PATH=data/eva.db
EVA_UI_DIR=ui/web
EVA_TEMPLATE_DIR=ui/web/templates
EVA_STATIC_DIR=ui/web/static
EVA_SNAPSHOT_DIR=data/snapshots
EVA_LATEST_SNAPSHOT_PATH=data/snapshots/latest.json
EVA_PROFILE_PATH=data/profile.json
EVA_PERSONA_PATH=data/persona.json
EVA_SELF_MODEL_PATH=data/self_model.json

# Timing (seconds)
EVA_TICK_INTERVAL_SEC=0.5
EVA_QUEUE_POLL_TIMEOUT_SEC=0.5
EVA_MAX_RECENT_ITEMS=20
EVA_REQUEST_TIMEOUT_SEC=8.0
EVA_RESULT_TTL_SEC=60.0
EVA_SCHEDULER_TICK_INTERVAL_SEC=10
EVA_SCHEDULER_MAINTENANCE_INTERVAL_SEC=60
EVA_SCHEDULER_SNAPSHOT_INTERVAL_SEC=120
EVA_STAGNATION_THRESHOLD_SEC=86400
EVA_REMINDER_COOLDOWN_SEC=43200

# Feature flags
EVA_ENABLE_V02_PIPELINE=false

# ── LLM Configuration ───────────────────────────────────────
# EVA auto-detects provider from API keys:
#   ANTHROPIC_API_KEY → Claude
#   OPENAI_API_KEY   → OpenAI
#   Neither          → mock (echo mode, safe for testing)
#
# Explicit override:
# EVA_LLM_PROVIDER=claude        # claude | openai
# EVA_LLM_MODEL=claude-sonnet-4-6-20250514

ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# ── LLM Tuning (applies to both providers) ─────────────────
# EVA_LLM_TEMPERATURE=0.7        # 0.0-2.0, lower = more deterministic
# EVA_LLM_MAX_TOKENS=1024        # max response length
# EVA_LLM_TOP_P=0.9             # nucleus sampling
# EVA_LLM_TIMEOUT=30            # request timeout seconds

# ── Storage Backend ─────────────────────────────────────────
# EVA_STORAGE_BACKEND=sqlite     # sqlite (default) | postgresql
# PostgreSQL (when backend=postgresql):
# EVA_PG_HOST=localhost
# EVA_PG_PORT=5432
# EVA_PG_DATABASE=eva
# EVA_PG_USER=eva
# EVA_PG_PASSWORD=
