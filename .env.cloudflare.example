# Copy to .env.cloudflare. Keep real tokens out of Git.
# Used by: python -m app.cloudflare_server
# The Cloudflare administration token MUST NOT be used as EVA_API_TOKEN.
EVA_API_TOKEN=
EVA_CF_ACCESS_TEAM_DOMAIN=
EVA_CF_ACCESS_AUD=
EVA_CF_ACCESS_ALLOWED_EMAILS=
EVA_PUBLIC_ORIGIN=https://eva.bianhua.cc.cd
